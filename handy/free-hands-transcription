#!/usr/bin/env python3
import json
import os
import socket
import sys
from pathlib import Path

SOCKET = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "free-hands/control.sock"
text = sys.stdin.read().rstrip("\n")
if not text:
    raise SystemExit(0)
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
    # Codex may take longer than a short network-style timeout while it
    # prepares audio or a vision response. Keep the hook bounded, but allow
    # normal long requests to complete without Handy falling back to paste.
    sock.settimeout(180)
    try:
        sock.connect(str(SOCKET))
    except (FileNotFoundError, ConnectionRefusedError) as exc:
        raise SystemExit(f"FREE-HANDS no está activo ({SOCKET})") from exc
    sock.sendall(json.dumps({"command": "ingest", "text": text}).encode())
    while sock.recv(65536):
        pass
